{
  "manifest_version": 3,
  "name": "Better Bogleheads",
  "version": "3.0.0",
  "description": "Supercharges the Bogleheads.org forum with visual enhancements, smart filtering, dark mode, and more.",
  "author": "David Neiss",
  "permissions": ["storage", "sidePanel", "contextMenus", "scripting"],
  "host_permissions": ["*://*.bogleheads.org/*"],
  "omnibox": { "keyword": "bh" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Better Bogleheads"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [{
    "matches": ["*://*.bogleheads.org/*"],
    "js": ["content.js"]
  }],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+B" },
      "description": "Toggle side panel"
    },
    "toggle-hide-read": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Toggle hide read topics"
    },
    "navigate-active-topics": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Navigate to active topics"
    },
    "mark-topic-read": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Mark current topic as read"
    }
  }
}
